-- The king
d1 $ s "[bd bd] <less bd bd [less bd]>, cp [cp sd] cp" # amp 1.3
   # lpf (slow 8 $ range 800 4000 saw)
   # gain (slow 8 $ range 1 1.2 saw)

-- The prince
d1 $ s "[bd bd] <bd bd bd [bd bd]>, cp cp cp"
    # amp 1.2


-- Off-beat groove
do
    d2 $ fast 2 $ n "0 0 <0 0 1 1 0 0 1 3>" # s "superpwm" # amp 0.2
       # octave "3 3 4"
       # legato 4
       # cut 1
       # lpf 600
       # hpf 50
       # distort 1
       # lfo 1
    d3 $ fast 2 $ n "0 0 <<0 1 1 1> <0 3 3 3>>" # s "supergong" # amp 0.4
       # distort 1
       # octave 3
       # lfo 2
       # lpf (slow 16 $ range 400 1200 saw)
       # hpf (slow 32 $ range 0 100 saw)

-- Staccato groove
do
   d2 $ slow 1 $ n "0 <0 [0 0]> ~" # s "supersaw" # amp 0.5
       # legato 0.4
       # octave 3
       # cut 1
       # distort 1
       # pan (slow 4 $ sine)
   d3 $ fast 2 $ n "0 0 0" # s "supersquare, superpwm"
       # lpf (slow 16 $ range 400 4000 saw)
       # octave "<4 2 4 3>"
       # lfo 0.5

-- Wobbly groove
do
    d2 $ fast 4 $ every 4 (slow 2) $ n "0 0 <1 0>" # s "superpwm" # amp 1
        # octave "3 3 <3 4>"
        # legato 0.5
        # lpf (slow 8 $ range 800 1600 saw)
        # cut 1
        # room 0.5
    d3 $ fast 1 $ n "0 0 0" # s "supersaw" # amp 0.4
        # octave "6 5 <4 3>"
        # voice 1
        # phasr 4
        # phasdp 0.8
        # lfo 2
        # lpf (slow 16 $ range 100 1200 saw)


-- The jam
do
    d1 $ slow 2 $ s "bd <[sd sd] sd sd sd> <[bd bd] bd> <[sd sd sd sd] sd sd sd>, hh hh <[hh hh] hh hh hh> hh hh hh <hh hh hh [hh hh]> hh"

    d2 $ fast 2 $ n "<[d4 d4] [d4 cs3]> ~ d4 <[d4] [d4 cs3] ~ >" # s "supersquare"

    d3 $ fast 1 $ n "d3 d2" # s "supersaw"

    d4 $ fast 1 $ n "d4 <d4 cs3 d4 [d4 d4]> d4 cs3" # s "bass:2"

    d5 $ slow 2 $ s "<tink:1 metal:1> metal:2 ~ <metal:3 metal:3 tink:3 [metal:1 metal:1 metal:1 metal:1]>"

