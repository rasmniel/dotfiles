{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "default_agent": "Tabula Rasa",
  "experimental": {
    "disable_paste_summary": true,
  },
  "agent": {
    "plan": {
      "disable": true
    },
    "build": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    }
  },
  "permission": {
    "bash": {
      // alias
      "alias": "deny",
      "alias *": "deny",
      // git
      "git *": "deny",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      // npm
      "npm *": "deny",
      "npm i": "allow",
      "npm install": "allow",
      "npm start": "allow",
      "npm test": "allow",
      "npm ci *": "allow",
      "npm i *": "ask",
      "npm install *": "ask",
      "npm run *": "allow",
      // npx
      "npx *": "deny"
    }
  }
}
