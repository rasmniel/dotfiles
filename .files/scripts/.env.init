# Root directory where projects live.
export PROJECT_ROOT="$HOME/projects"
# The service installation directory to deploy from.
export SERVICE_ROOT="$HOME/services"
# The destination directory for services to be deployed to.
export SERVER_ROOT="/srv"
# Deploy key for git SSH.
export SSH_KEY_FILE_DIR="$HOME/.ssh/deploy_keys"
# Default namespace to use when none is provided.
export DEFAULT_GIT_NAME="user"
# Default remote to use when none is provided.
export DEFAULT_GIT_REMOTE="git.com"
# IPs for logging with jq.
export KNOWN_IPS='"::1","::1"'
