# The service installation directory to deploy from.
export SOURCE_ROOT="$HOME/services"

# The destination directory for services to be deployed to.
export SERVICE_ROOT="/srv"

# The domains where services should live. Required to setup Caddy.
# localhost is typically already mapped and doesn't need a manual host entry.
export PRIVATE_DOMAIN="localhost"
# Public domain to host on the internet. Required for public hosts.
export PUBLIC_DOMAIN="domain.com"
