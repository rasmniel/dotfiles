# vim: set ft=sh

# Source all .files indiscriminately
for file in "$HOME"/.files/*.sh; do
    # shellcheck disable=SC1090
    . "$file"
done

test -f "$HOME/.aliases" && . "$HOME/.aliases"

# Configure bash-specific options with `shopt`
shopt -s histappend
shopt -s checkwinsize

# Load bash completion, if it exists
if ! shopt -oq posix; then
    if [ -f /usr/share/bash-completion/bash_completion ]; then
        . /usr/share/bash-completion/bash_completion
    elif [ -f /etc/bash_completion ]; then
        . /etc/bash_completion
    fi
fi

# History control
HISTCONTROL=ignoreboth
HISTSIZE=1000
HISTFILESIZE=2000

# PATH exports
export PATH="$PATH:$HOME/bin:$HOME/.local/bin:$HOME/.opencode/bin"

# Set default editors
export SUDO_EDITOR="$HOME/bin/nvim"
export EDITOR="$HOME/bin/nvim"

# Disable monitoring, effectively unmapping `ctrl+z` as a shortcut for `bg`
set +m

