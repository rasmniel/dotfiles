[alias]
	s = status
	ss = status --short
	a = add --all
	r = reset
	c = commit
	p = push
	pom = push -u origin main
	pub = !git push -u origin "$(git rev-parse --abbrev-ref HEAD)"
	m = merge
	b = branch
	ba = branch -av
	t = tag
	f = fetch
	pl = pull
	co = checkout
	d = diff
	dc = diff --cc
	ds = diff --staged
	l = log
	gr = log --all --decorate --oneline --graph
	tr = log --all --decorate --graph --relative-date

[core]
	editor = "vi"

[init]
	defaultBranch = main

[include]
	path = .gitconfig.local

